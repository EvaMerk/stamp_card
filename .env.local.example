# Supabase-Projekt-Zugangsdaten
# 1. Projekt anlegen unter https://supabase.com (kostenloser Tier reicht)
# 2. Project Settings → API: URL und anon/public Key kopieren
# 3. Diese Datei nach .env.local kopieren und die Werte eintragen
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN_SUPABASE_ANON_KEY
